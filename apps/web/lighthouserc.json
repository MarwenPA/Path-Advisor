{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "seo"],
        "throttlingMethod": "simulate"
      },
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/metiers/technicien-aeronautique",
        "http://localhost:3000/formations/lycee-pro-aviation",
        "http://localhost:3000/devenir-technicien-aeronautique",
        "http://localhost:3000/3eme/quel-bac-pour-technicien-aeronautique"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3000/(?!metiers/|formations/)",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/(metiers|formations)/",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2600 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
